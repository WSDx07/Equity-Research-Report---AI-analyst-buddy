{
  "description": "Lab 07 worksheet number check. The command runs `python`, so start Codex with the .venv active (macOS/Linux: source .venv/bin/activate; Windows: .\\.venv\\Scripts\\Activate.ps1).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/skills/us-spinoff-worksheet/hooks/worksheet_hook.py",
            "timeout": 30,
            "statusMessage": "Checking saved worksheet numbers"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/skills/us-spinoff-worksheet/hooks/worksheet_hook.py",
            "timeout": 30,
            "statusMessage": "Checking worksheet before completion"
          }
        ]
      }
    ]
  }
}
