# Required by the equity desk flow. Copy this file to .env and fill in your values.
PURDUE_API_KEY=
SEC_USER_AGENT=Your Name your.email@example.com

# Optional: defaults to gpt-oss:120b when blank.
PURDUE_MODEL=
# Optional: without this key, the financial statement cross-check is unavailable.
FINDATA_API_KEY=

# Only needed for the separate research_analyst.py program.
OPENAI_API_KEY=
RESEARCH_ANALYST_MODEL=openai/gpt-4.1-mini
